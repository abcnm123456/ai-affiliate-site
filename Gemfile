source "https://rubygems.org"

# Hello! This is the right place to manage Jekyll configuration. You can manage all kinds of cool stuff here!

# Configuration settings go in `_config.yml` - for most purposes, you won't need to touch this file.

# For technical reasons, this file is NOT reloaded automatically when you use 'bundle exec jekyll serve'. If you change this file, please restart the server process.

gem "jekyll", "~> 4.3.0"
gem "jekyll-feed", "~> 0.17.0"
gem "minima", "~> 2.5"
gem "kramdown-parser-gfm", "~> 1.1.0"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]

# Performance-booster for watching directories on Windows
gem "wdm", "~> 0.1.1", :install_if => Gem.win_platform?
